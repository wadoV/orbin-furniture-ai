# ─── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# ⚠ service_role key en: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_KEY=eyJ...

# ─── Server ─────────────────────────────────────────────
PORT=3003
NODE_ENV=production
CLIENT_URL=https://orbin.app
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERA_UN_SECRET_SEGURO

# ─── Gemini (Google AI Studio) ──────────────────────────
# Obtén tu API key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# ─── Ollama (Local LLM — fallback opcional) ─────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b
