# ─── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# OPCIÓN A — Nuevos formatos (recomendado por Supabase 2025):
#   Publishable key → Settings → API Keys → Publishable key (sb_publishable_...)
#   Secret key      → Settings → API Keys → Secret keys → default (sb_secret_...)
# SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_SERVICE_KEY=sb_secret_...

# OPCIÓN B — Legacy format (JWT, compatible con el SDK actual):
#   ⚠ AMBAS llaves en: Settings → API Keys → Legacy anon, service_role API keys
#   anon key      → botón "Copy"   → pegar aquí
#   service_role  → botón "Reveal" → botón "Copy" → pegar aquí
#   ⚠ NUNCA uses el mismo valor para ambas — SUPABASE_SERVICE_KEY bypassa RLS
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ─── Server ─────────────────────────────────────────────
PORT=3003
NODE_ENV=production
CLIENT_URL=https://orbin.app
#
# JWT_SECRET — REQUIRED in production and development (not test).
#   Format : 64-character lowercase hex string (256-bit entropy).
#   Minimum: 32 characters — server will refuse to start if shorter.
#   NEVER use the placeholder below or commit the real value to git.
#
#   Generate with (run once in terminal, copy output):
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# ─── Gemini (Google AI Studio) ──────────────────────────
# Obtén tu API key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# ─── Ollama (Local LLM — fallback opcional) ─────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# ─── Pagos (Stripe) ──────────────────────────────────────
# Obtén tus llaves en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret → Stripe Dashboard → Developers → Webhooks → tu endpoint → "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs de cada plan → Stripe Dashboard → Product catalog → Pricing
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ─── Pagos (Mercado Pago — Brasil/Chile) ────────────────
# Obtén tu Access Token en: https://www.mercadopago.com/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-...
